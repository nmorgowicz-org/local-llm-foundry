{
  "extends": ["github>nmorgowicz-org/docker-compose-config//renovate"],
  "ignorePaths": ["**/node_modules/**", "**/bower_components/**"],
  "prCreation": "immediate",
  "packageRules": [
    {
      "description": "Batch Rust dependency updates to avoid Cargo.lock conflicts",
      "matchManagers": ["cargo"],
      "groupName": "Rust dependencies",
      "groupSlug": "rust-dependencies",
      "separateMajorMinor": false,
      "automerge": false,
      "addLabels": ["cargo"]
    },
    {
      "description": "Defer GTK 0.19 until the Wry GTK stack supports it",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["gtk"],
      "allowedVersions": "<0.19"
    },
    {
      "description": "Batch Node dependency updates across application and UI test packages",
      "matchManagers": ["npm"],
      "groupName": "Node dependencies",
      "groupSlug": "node-dependencies",
      "separateMajorMinor": false,
      "automerge": false,
      "addLabels": ["npm"]
    },
    {
      "description": "Batch GitHub Actions dependency updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": false,
      "automerge": false,
      "addLabels": ["github-actions"]
    },
    {
      "description": "Playwright updates require manual review - version bumps can break tests",
      "matchPackageNames": ["@playwright/test", "playwright", "playwright-core"],
      "automerge": false,
      "labels": ["dependencies", "manual-review"]
    }
  ]
}
