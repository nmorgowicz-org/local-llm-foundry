{
  "name": "llama-monitor-ui-tests",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:in-memory": "playwright test --grep @in-memory-test",
    "test:rapid-mlx-contract": "playwright test core/phase7-presets.spec.js --grep @in-memory-test",
    "test:fake-data": "playwright test --grep @fake-data-bypass",
    "test:runtime": "LLAMA_MONITOR_HAS_RUNTIME=1 playwright test --grep @runtime-required",
    "test:ssh": "playwright test remote-agent-ssh.integration.spec.js",
    "test:ai": "LLAMA_MONITOR_HAS_AI=1 playwright test",
    "test:headed": "playwright test --headless=false",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "capture:list": "node capture.mjs --list-scenarios",
    "capture:sparkline": "node capture.mjs --scenario sparkline",
    "capture:gifs": "node capture.mjs --scenario gifs",
    "update-baseline": "node -e \"import('./update-baseline.mjs').then(m => m.default())\"",
    "capture:group": "node capture/cli-group.mjs",
    "capture:manifest": "node capture/cli-manifest.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "puppeteer": "25.5.0"
  }
}
