# Python bytecode (scripts/build-mtp-head.py and friends)
__pycache__/
*.pyc

# Benchmark receipt scratch space. Deliberately untracked: these are large,
# machine-specific artifacts, and the evidence record cites them by path
# knowing they will not survive a clean checkout.
/tmp/
.tokensave
